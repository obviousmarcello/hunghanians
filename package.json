{
  "name": "hunghanians",
  "version": "1.0.0",
  "private": true,
  "description": "Hunghanians website and backend API (contact messages and event registrations).",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "gallery": "node scripts/gallery.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "exif-reader": "^2.0.3",
    "sharp": "^0.35.5"
  }
}
