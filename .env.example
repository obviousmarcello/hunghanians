# Copy to .env (or set these in your hosting provider) - all are optional.

PORT=3000
# Number of reverse proxies in front of the app (1 behind Nginx/Render/Fly etc.)
TRUST_PROXY=0

# Database. With none of the MySQL settings below, a local SQLite file is used:
DATABASE_PATH=./data/hunghanians.db
# MySQL (required on hosts without a persistent disk, e.g. GoDaddy Node.js Hosting).
# Either one URL...
# DATABASE_URL=mysql://user:password@host:3306/database
# ...or separate variables. MYSQL_* and DB_* names are both accepted:
# MYSQL_HOST / DB_HOST, MYSQL_PORT / DB_PORT, MYSQL_USER / DB_USER (or DB_USERNAME),
# MYSQL_PASSWORD / DB_PASSWORD, MYSQL_DATABASE / DB_NAME
# DB_SSL=true            # if the database requires TLS
# EVENT_CONFIG_PATH=./server/event.json

# Enables /api/admin/* (at least 16 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Where contact messages and registration notifications are sent.
ORGANIZER_EMAIL=hunghanians@gmail.com

# SMTP for outgoing email. Without SMTP_HOST, emails are only logged.
# For Gmail use smtp.gmail.com:465, SMTP_SECURE=true and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hunghanians <hunghanians@gmail.com>"

# Only needed if the API is hosted on a different domain than the website.
# CORS_ORIGINS=https://hunghanians.hu

# Contact/registration submissions allowed per IP per window.
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=900000
